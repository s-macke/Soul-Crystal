</div>
<br>
<div id="richtungen"> 
</div>

</td></tr></table>




</td>




<script type="text/javascript">

	objectposition[OBJECTS.DAVE] = 0x1;
	WriteObject1();
	WriteObject2();
	WriteInventar();
	WriteRichtungen();
	WriteTitle();
</script>





