function ParseOST()
{
	roomnumber = objectposition[OBJECTS.DAVE];
	var addr6994;

	addr6994 = 0xFF;
	if ((east[roomnumber] != 0x00))
	{
		roomnumber = east[roomnumber];
		objectposition[OBJECTS.DAVE] = roomnumber;
		textoutput = roomnumber + 106;
	//	Code2E5B();
		addr6994 = roomnumber;
	}
	else
	{
		if ((east[roomnumber] == 0x00))
		{
			textoutput = 0x05;
		}
	
	}
	/*
	if ((addr6994 != 0xFF))
	{
		Code4087();
	}
	*/


//	alert(textoutput);

}

// ---------------------------------------------------

function Parse(command)
{

//	alert(this.form.objects1.options[this.form.objects1.selectedIndex].value);
//alert(this.form.Pizza.options[this.form.Pizza.selectedIndex].value)
//	alert(document.forms["objects1"].selectedIndex);
//	alert(document.objects1.selectedIndex);
	
	roomnumber = objectposition[OBJECTS.DAVE];
	switch (command) 
	{
		case COMMAND.OST: ParseOST(); break;	
		case COMMAND.SUED: ParseSUED(); break;	
		case COMMAND.NORD: ParseNORD(); break;	
		case COMMAND.WEST: ParseWEST(); break;	
		case COMMAND.BETRACHTEN: ParseBETRACHTEN(); break;	
		case COMMAND.DRUECKE: ParseDRUECKEN(); break;	
		case COMMAND.NIMM: ParseNIMM(); break;	
		case COMMAND.SPRICH: ParseSPRICH(); break;
		case COMMAND.OEFFNE: ParseOEFFNE(); break;
		case COMMAND.ENTRIEGELE: ParseENTRIEGELE(); break;
		case COMMAND.WENDE: ParseWENDE(); break;
		case COMMAND.VERLIERE: ParseVERLIERE(); break;
			
	}

	WriteObject1();
	WriteObject2();
	WriteInventar();
	WriteRichtungen();	
	WriteTitle();

	document.getElementById("text").innerHTML = text[textoutput-1];

}

function WriteInventar()
{
	var s;
	
	s = "Sie führen bei sich:<br>";

	for(i=0; i<167; i++)
	{
		if (objectposition[i] == 0xFF)
			s += objectnames[i] + "<br>";
	
	}
	
	document.getElementById("inventar").innerHTML = s;
}

function WriteTitle()
{
	roomnumber = objectposition[OBJECTS.DAVE];
	document.getElementById("title").innerHTML = "<b>" + roomnames[roomnumber-1] + "</b>" + roomnumber;
}

function WriteRichtungen()
{
	var s;
	
	s = "Mögliche Richtungen:<br>";
	roomnumber = objectposition[OBJECTS.DAVE];

		if (north[roomnumber] != 0)
			s += "NORDEN" + "<br>";
		if (east[roomnumber] != 0)
			s += "OSTEN" + "<br>";
		if (west[roomnumber] != 0)
			s += "WESTEN" + "<br>";
		if (south[roomnumber] != 0)
			s += "SÜDEN" + "<br>";
	
	document.getElementById("richtungen").innerHTML = s;
}

function WriteObject1()
{

	roomnumber = objectposition[OBJECTS.DAVE];

	var s="";

	s += "<form>";
	s += "<select name=\"objects1\" size=\"10\" style=\"background-color:#000000; color:#FFFFFF;\" onchange=\"object1=this.options[this.selectedIndex].value \">";

	for(i=0; i<167; i++)
	{
		if (objectposition[i] == roomnumber)
			s += "   <option value=\"" + i + "\" >" + objectnames[i] + "</option>";
	}
	s+= "<option>---------------------------------</option>";
	
	for(i=0; i<167; i++)
	{
		if (objectposition[i] == 0xFF)
			s += "   <option value=\"" + i + "\" >" + objectnames[i] + "</option>";
	}

	s += "</select>";
	s += "</form>";

	document.getElementById("object1").innerHTML = s;

}

function WriteObject2()
{

	roomnumber = objectposition[OBJECTS.DAVE];

	var s="";

	s += "<form>";
	s += "<select name=\"objects1\" size=\"10\" style=\"background-color:#000000; color:#FFFFFF;\" onchange=\"object2=this.options[this.selectedIndex].value \">";

	for(i=0; i<167; i++)
	{
		if (objectposition[i] == roomnumber)
			s += "   <option value=\"" + i + "\" >" + objectnames[i] + "</option>";
	}
	s+= "<option>---------------------------------</option>";
	
	for(i=0; i<167; i++)
	{
		if (objectposition[i] == 0xFF)
			s += "   <option value=\"" + i + "\" >" + objectnames[i] + "</option>";
	}

	s += "</select>";
	s += "</form>";

	document.getElementById("object2").innerHTML = s;

}




</script>

</head>


