<a href="javascript:Parse(COMMAND.SUED)" >Sued</a>
<a href="javascript:Parse(COMMAND.OST)">Ost</a>
<a href="javascript:Parse(COMMAND.WEST)">West</a>
<br>
<a href="javascript:Parse(COMMAND.BETRACHTEN)">Betrachten</a>
