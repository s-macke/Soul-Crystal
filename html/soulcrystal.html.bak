function ParseVERLIERE()
{

if ((objectposition[object1] != 0xFF))
{
	textoutput = 0x41;
	return;
}

if ((object1 == OBJECTS.AMULETT) || (object1 == OBJECTS.FELLSTIEFEL) || (object1 == OBJECTS.JEANS) || 
(object1 == OBJECTS.BAUMWOLLHEMD) || (object1 == OBJECTS.TURNSCHUHE) || (object1 == OBJECTS.TSHIRT) || 
(object1 == OBJECTS.PURPURMANTEL) || (object1 == OBJECTS.HOSE) || (object1 == OBJECTS.BADEHOSE))
{
	if ((objectstatus[object1] == 0x1))
	{
		objectstatus[object1] = 0x0;
	}
}

if ((object1 == OBJECTS.BLUT))
{
	textoutput = 0x026E;
	return;
}

if ((object1 == OBJECTS.GEBET))
{
	textoutput = 0x026F;
	return;
}

if ((object1 == OBJECTS.ZAUBERSPRUCH))
{
	textoutput = 0x0270;
	return;
}

textoutput = 0x08;
objectposition[object1] = roomnumber;


}


// ---------------------------------------------------


function ParseWENDE()
{

if (object2 == OBJECTS.DAVE)
{
	if ((object1 == OBJECTS.BADEHOSE) && (objectstatus[OBJECTS.BADEHOSE] == 0x00))
	{
		if (objectstatus[OBJECTS.JEANS] == 0x01)
		{
			textoutput = 0x18;
			return;
		}
		
		textoutput = 0x62;
		objectstatus[OBJECTS.BADEHOSE] = 0x01;
		objectposition[OBJECTS.BADEHOSE] = 0xFF;
		return;
	}
	else
	{
		if ((object1 == OBJECTS.JEANS) && (objectstatus[OBJECTS.JEANS] == 0x00))
		{
			textoutput = 0xA1;
			objectstatus[OBJECTS.JEANS] = 0x01;
			objectposition[OBJECTS.JEANS] = 0xFF;
			return;
		}
		else
		{
			if ((object1 == OBJECTS.TURNSCHUHE) && (objectstatus[OBJECTS.TURNSCHUHE] == 0x00))
			{
				textoutput = 0xA2;
				objectstatus[OBJECTS.TURNSCHUHE] = 0x01;
				objectposition[OBJECTS.TURNSCHUHE] = 0xFF;
				return;
			}
			else
			{
				if ((object1 == OBJECTS.TSHIRT) && (objectstatus[OBJECTS.TSHIRT] == 0x00))
				{
					textoutput = 0xA3;
					objectstatus[OBJECTS.TSHIRT] = 0x01;
					objectposition[OBJECTS.TSHIRT] = 0xFF;
					return;
				}
				
			}
			
		}
		
	}
	
}

if ((object1 == OBJECTS.DAVE))
{
	if ((object2 == OBJECTS.ABENTEURER) || (object2 == OBJECTS.ORKKIND) || (object2 == OBJECTS.KADAVER) || 
	(object2 == OBJECTS.CUmATH) || (object2 == OBJECTS.EREMIT) || (object2 == OBJECTS.FAEHRMANN) || 
	(object2 == OBJECTS.FIRON) || (object2 == OBJECTS.PORTIER) || (object2 == OBJECTS.KOENIG) || 
	(object2 == OBJECTS.MYLGOR) || (object2 == OBJECTS.DORFBEWOHNER) || (object2 == OBJECTS.VERKAEUFER) || 
	(object2 == OBJECTS.YETI) || (object2 == OBJECTS.ZARGON))
	{
		textoutput = 0x65;
		return;
	}
	
	if ((object2 == OBJECTS.GAESTEBETT))
	{
		textoutput = 0x63;
		return;
	}
	
	if ((object2 == OBJECTS.STUHL))
	{
		textoutput = 0xA5;
		return;
	}
	
	if ((object2 == OBJECTS.KLEIDERSCHRANK))
	{
		//textoutput = 0x026C;
		textoutput = 0xD1;
		return;
	}
	
}

textoutput = 0x67;


}
