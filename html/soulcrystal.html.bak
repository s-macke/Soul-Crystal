function ParseENTRIEGELE()
{

var canunlockindex = -1;
var object2index = -1;
for(i=0; i< 0xB; i++)
{
	if (canunlock[i*2 + 0] == object1)
	{
		canunlockindex = i;
		object2index = canunlock[i*2 + 1];
	}
}


if (canunlockindex == -1)
{
	textoutput = 0x18;
	return;
}

if ((object2index != object2))
{
/*
	addr69B3 = 0x82EF;
	addr6992 = 0x01;
	addr699F = mem[addr69B3];
	addr69B3++;
	addr6996 = addr699F;
	if ((addr6996 == object2))
	{
		goto mem820C;
	}
	
	addr6992 = addr6992 + 0x01;
	if ((addr6992 <= 0x07))
	{
		goto mem81F2;
	}
	
	
	mem820C:
	if ((addr6992 > 0x07))
	{
		textoutput = 0x17;
		return;
	}
	
	textoutput = 0x6A;
	return;
*/	
}
else
{
	if (object2index == object2)
	{
		if (objectstatus[object1] > 0x0)
		{
			textoutput = 0x69;
			return;
		}
		else
		{
			if (objectstatus[object1] == 0x0)
			{
				objectstatus[object1] = 0x2;
				textoutput = 0x16;
			}
			
		}
		
	}
	
}



}
// ---------------------------------------------------


function ParseOEFFNE()
{

if ((object1 == OBJECTS.JEANS) || (object1 == OBJECTS.HOSE))
{
//	textoutput = 0x0268;
	textoutput = 0xCD;
	return;
}

var canopenindex = -1;
var direction = 0;
var to = 0;
for(i=0; i<0x1B; i++)
{
	if (canopen[i*3+0] == object1)
	{
		canopenindex = i;
		direction = canopen[i*3+1];
		to = canopen[i*3+2];
	}
}

if ((canopenindex == -1))
{
	textoutput = 0x58;
	return;
}

if ((objectstatus[object1] == 0x0))
{
	textoutput = 0x11;
	return;
}
else
{
	if ((objectstatus[object1] == 0x1))
	{
		textoutput = 0x57;
		return;
	}
	else
	{
		if ((objectstatus[object1] == 0x2))
		{
			objectstatus[object1] = 0x1;
			if ((direction == 0x01))
			{
				north[roomnumber] = to;
			}
			else
			{
				if ((direction == 0x02))
				{
					south[roomnumber] = to;
				}
				else
				{
					if ((direction == 0x03))
					{
						west[roomnumber] = to;
					}
					else
					{
						if ((direction == 0x04))
						{
							east[roomnumber] = addr6998;
						}
						
					}
					
				}
				
			}
			
			textoutput = 0x56;
		}
		
	}
	
}


}
// ---------------------------------------------------


function ParseSPRICH()
{

textoutput = 0x5B;
cantalkindex = -1;

for(i=0; i<0xE; i++)
{
	if (cantalk[i*2] == object1)
	{
		textoutput = cantalk[i*2+1];		
		cantalkindex = i;
	}
}

/*

addr69B3 = 0x8366

addr6992 = 0x01

addr699F = mem[addr69B3] + (mem[addr69B3+1] << 8);
addr69B3 += 2;
addr6996 = addr699F

addr699F = mem[addr69B3] + (mem[addr69B3+1] << 8);
addr69B3 += 2;
textoutput = addr699F
if ((addr6996 == object1))
{
	goto mem7F54;
}

addr6992 = addr6992 + 0x01
if ((addr6992 <= 0x0F))
{
	goto mem7F38;
}


mem7F54:
if ((addr6992 > 0x0F))
{
	textoutput = 0x5B
}
*/

if (cantalkindex == -1)
{
	textoutput = 0x5B;
}


if ((object1 == OBJECTS.PORTIER))
{
	textoutput = 0x9D;
	objectposition[OBJECTS.ZIMMERSCHLUESSEL] = roomnumber;
	objectposition[OBJECTS.PORTIER] = 0x00;
	return;
}

if ((object1 == OBJECTS.DORFBEWOHNER) && (objectstatus[OBJECTS.DORFBEWOHNER] == 0x00))
{
	textoutput = 0x9E;
	objectstatus[OBJECTS.DORFBEWOHNER] = 0x01;
	return;
}
else
{
	if ((object1 == OBJECTS.DORFBEWOHNER) && (objectstatus[OBJECTS.DORFBEWOHNER] == 0x01))
	{
		textoutput = 0x9F;
		return;
	}
	
}

if ((object1 == OBJECTS.EINHORN) && (objectstatus[OBJECTS.WOLF] == 0x01))
{
	objectposition[OBJECTS.KRISTALLKUGEL] = roomnumber;
	objectposition[OBJECTS.EINHORN] = 0x00;
	west[0x0F] = 0x19;
	textoutput = 0xA0;
	return;
}


}


// ---------------------------------------------------

function ParseNIMM()
{

var cantakeobject = -1;
for(i=0; i<40; i++)
{
	if (cantake[i] == object1)
	{
		cantakeobject = i;
	}
	
}


	var addr6992 = cantakeobject;
	
	if ((addr6992 == -1))
	{
		textoutput = 0x0E;
	} else
	if ((objectposition[object1] == 0xFF))
	{
		textoutput = 0x0D;
	} else
	{
		objectposition[object1] = 0xFF;
		textoutput = 0x0C;
	}
	
	if ((object1 == OBJECTS.SPEISEKARTE))
	{
		textoutput = 0x96;
		objectposition[object1] = roomnumber;
		return;
	}

}


// ---------------------------------------------------

function ParseDRUECKEN()
{

if ((object1 == OBJECTS.KLINGEL))
{
	if ((objectstatus[OBJECTS.KLINGEL] < 0x03))
	{
		objectstatus[OBJECTS.KLINGEL] = objectstatus[OBJECTS.KLINGEL] + 0x01;
	}
	
	if ((objectstatus[OBJECTS.KLINGEL] == 0x03) && (objectposition[OBJECTS.ZIMMERSCHLUESSEL] == 0x00))
	{
		objectposition[OBJECTS.PORTIER] = roomnumber;
		objectstatus[OBJECTS.KLINGEL] = 0x04;
		textoutput = 0x9C;
		return;
	}
	else
	{
		if ((objectstatus[OBJECTS.KLINGEL] == 0x03) && (objectposition[OBJECTS.ZIMMERSCHLUESSEL] != 0x00))
		{
			objectstatus[OBJECTS.KLINGEL] = 0x00;
			textoutput = 0x9B;
			return;
		}
		
	}
	
	textoutput = 0x9B;
	return;
}

textoutput = 0x59


}


// ---------------------------------------------------

function ParseBETRACHTEN()
{

textoutput = objectdescription[object1];
if ((object1 == OBJECTS.TRESEN) && (objectposition[OBJECTS.KLINGEL] == 0x00))
{
	objectposition[OBJECTS.KLINGEL] = roomnumber;
	if ((objectposition[OBJECTS.PROSPEKT] == 0x00))
	{
		objectposition[OBJECTS.PROSPEKT] = roomnumber;
	}
	
	objectdescription[OBJECTS.TRESEN] = 0x0B;
}

if ((object1 == OBJECTS.PROSPEKT) && (objectstatus[OBJECTS.PROSPEKT] == 0x01))
{
	textoutput = 0x80;
}


if ((object1 == OBJECTS.ESSTISCH2) && (objectposition[OBJECTS.SPEISEKARTE] == 0x00))
{

	objectposition[OBJECTS.SPEISEKARTE] = roomnumber;
	objectdescription[OBJECTS.ESSTISCH2] = 0x90;
}
else
{
	if ((object1 == OBJECTS.ESSTISCH2) && (objectdescription[OBJECTS.ESSTISCH2] == 0x90))
	{
		objectdescription[OBJECTS.ESSTISCH2] = 0x0B;
	}
	
}

if ((object1 == OBJECTS.SPEISEKARTE))
{
	textoutput = 0x89;
}

if ((object1 == OBJECTS.STUHL) && (objectposition[OBJECTS.BADEHOSE] == 0x00))
{
	objectposition[OBJECTS.BADEHOSE] = roomnumber;
	objectdescription[OBJECTS.STUHL] = 0x0B;
}


}


