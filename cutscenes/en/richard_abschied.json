 "cues": [
  {
   "start": 2.535,
   "end": 5.515,
   "text": "\"You know the magic spell!\", says the king impatiently,"
  },
  {
   "start": 5.555,
   "end": 8.075,
   "text": "\"But that's really all I could do for you...:"
  },
  {
   "start": 8.143,
   "end": 14.315,
   "text": "The fate of my world is in your hands, but my prayers are with you - farewell...\""
  },
  {
   "start": 14.383,
   "end": 16.155,
   "text": "The spirit of the king becomes more and more"
  },
  {
   "start": 16.228,
   "end": 20.795,
   "text": "transparent until it is finally completely invisible..."
  },
  {
   "start": 20.944,
   "end": 25.115,
   "text": "In view of the heavy burden that weighs on you with this enormous responsibility,"
  },
  {
   "start": 25.155,
   "end": 30.395,
   "text": "you suddenly feel incredibly alone and abandoned..."
  }
 ]
