 "cues": [
  {
   "start": 2.642,
   "end": 6.74,
   "text": "As you enter the clearing, you hear a terrible growling and hissing ahead of you!"
  },
  {
   "start": 6.9,
   "end": 12.26,
   "text": "Startled, you stop and, to be safe, hide behind the nearest tree!"
  },
  {
   "start": 13.268,
   "end": 15.86,
   "text": "When your eyes have got a little used to the dim light,"
  },
  {
   "start": 15.9,
   "end": 19.54,
   "text": "you see two animals fighting on the other side of the clearing:"
  },
  {
   "start": 19.58,
   "end": 24.34,
   "text": "a big grey wolf and a delicate, white-shimmering unicorn,"
  },
  {
   "start": 24.38,
   "end": 28.26,
   "text": "whose coat is already completely stained with its bluish blood,"
  },
  {
   "start": 28.34,
   "end": 30.66,
   "text": "oozing from countless deep wounds."
  },
  {
   "start": 30.92,
   "end": 34.9,
   "text": "Noticing that the weakened unicorn's resistance is fading,"
  },
  {
   "start": 34.92,
   "end": 37.3,
   "text": "the wolf attacks it even more furiously!"
  },
  {
   "start": 38.32,
   "end": 40.98,
   "text": "The graceful creature no longer has the strength to hold"
  },
  {
   "start": 41.04,
   "end": 45.06,
   "text": "out much longer against the long, sharp teeth of the wolf..."
  }
 ]
}
