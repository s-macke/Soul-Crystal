 "cues": [
  {
   "start": 2.599,
   "end": 4.003,
   "text": "After it has recovered a little,"
  },
  {
   "start": 4.023,
   "end": 6.163,
   "text": "the unicorn thanks you for your help and"
  },
  {
   "start": 6.216,
   "end": 9.043,
   "text": "urgently warns you about continuing your way west."
  },
  {
   "start": 9.603,
   "end": 13.923,
   "text": "\"Once you have left this part of the forest, there is no way back...\","
  },
  {
   "start": 13.976,
   "end": 18.163,
   "text": "it says with an infinitely sad look in its deep blue eyes,"
  },
  {
   "start": 18.563,
   "end": 21.043,
   "text": "\"But take this little crystal ball:"
  },
  {
   "start": 21.07,
   "end": 23.763,
   "text": "it could help you find friends in this hostile world...\""
  },
  {
   "start": 23.987,
   "end": 27.763,
   "text": "With these words, the unicorn gives you a small,"
  },
  {
   "start": 27.823,
   "end": 31.763,
   "text": "glowing crystal ball, and whispers to you in a fading voice:"
  },
  {
   "start": 32.729,
   "end": 36.969,
   "text": "\"Think of me when you use it - I do not have long to live...\""
  },
  {
   "start": 37.097,
   "end": 38.729,
   "text": "With a last look back at you,"
  },
  {
   "start": 38.769,
   "end": 43.609,
   "text": "a look so full of regret and pain that it almost breaks your heart, the doomed,"
  },
  {
   "start": 43.657,
   "end": 47.209,
   "text": "beautiful creature turns away and slowly trots off,"
  },
  {
   "start": 47.289,
   "end": 51.689,
   "text": "without looking back at you again, until it has disappeared among the trees..."
  }
 ]
}
