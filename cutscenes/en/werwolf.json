 "cues": [
  {
   "start": 2.647,
   "end": 3.3,
   "text": "Heavens!"
  },
  {
   "start": 3.38,
   "end": 7.62,
   "text": "It is probably too late to even think of escaping: frozen with horror,"
  },
  {
   "start": 7.66,
   "end": 12.42,
   "text": "you have to watch as a huge black shadow rises behind a weathered gravestone -"
  },
  {
   "start": 12.468,
   "end": 14.02,
   "text": "only a few metres away from you!"
  },
  {
   "start": 14.169,
   "end": 21.14,
   "text": "Unable to move, you have to look on as it silently grows bigger and bigger..."
  },
  {
   "start": 22.0,
   "end": 26.32,
   "text": "Suddenly the clouds that had covered the full moon for a short while break apart -"
  },
  {
   "start": 26.98,
   "end": 29.52,
   "text": "and you cry out in panic and mortal fear:"
  },
  {
   "start": 29.552,
   "end": 35.52,
   "text": "your opponent is a huge grey werewolf, baring its sharp yellow teeth, certain of victory!"
  },
  {
   "start": 35.88,
   "end": 38.72,
   "text": "Hissing hoarsely and with outstretched arms,"
  },
  {
   "start": 38.773,
   "end": 43.12,
   "text": "it starts to move - step by step, for it is in no hurry..."
  },
  {
   "start": 43.256,
   "end": 44.56,
   "text": "But suddenly it stops!"
  },
  {
   "start": 44.76,
   "end": 47.68,
   "text": "For a fraction of a second your eyes meet,"
  },
  {
   "start": 47.72,
   "end": 52.64,
   "text": "and you feel the lust for murder and the abysmal hatred blazing in its eyes..."
  }
 ]
}
