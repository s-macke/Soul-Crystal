 "cues": [
  {
   "start": 2.569,
   "end": 4.99,
   "text": "When the wolf sees you storming into the clearing,"
  },
  {
   "start": 5.023,
   "end": 7.95,
   "text": "your scrawny figure frightens him so much that he"
  },
  {
   "start": 8.004,
   "end": 11.31,
   "text": "immediately tucks in his tail and runs for his life!"
  },
  {
   "start": 12.462,
   "end": 17.715,
   "text": "After he has disappeared howling into the undergrowth, still shaken by so much misery,"
  },
  {
   "start": 17.755,
   "end": 20.514,
   "text": "the battered unicorn lies down exhausted on the"
  },
  {
   "start": 20.572,
   "end": 23.554,
   "text": "ground to recover a little from the uneven fight."
  },
  {
   "start": 23.775,
   "end": 29.315,
   "text": "Its nostrils tremble nervously, and its breathing is heavy and uneven..."
  }
