 "cues": [
  {
   "start": 2.636,
   "end": 7.3,
   "text": "You knock timidly on the door and wait: nothing happens!"
  },
  {
   "start": 7.4,
   "end": 11.22,
   "text": "You knock again, a little louder this time: no reaction!"
  },
  {
   "start": 11.99,
   "end": 15.7,
   "text": "You are just about to hammer on the door with all your might when,"
  },
  {
   "start": 15.8,
   "end": 19.3,
   "text": "exactly at the spot where the destructive power of your mighty fists"
  },
  {
   "start": 19.353,
   "end": 23.46,
   "text": "would very nearly have revealed itself in all its terrible glory,"
  },
  {
   "start": 23.54,
   "end": 26.66,
   "text": "a small hatch opens, and behind it a face appears"
  },
  {
   "start": 26.692,
   "end": 29.22,
   "text": "that can only barely be made out in the half-light!"
  },
  {
   "start": 30.222,
   "end": 34.742,
   "text": "\"What is your desire, stranger?\", the voice behind the door asks suspiciously."
  }
 ]
}
