 "cues": [
  {
   "start": 2.532,
   "end": 6.149,
   "text": "\"Du kennst den Zauberspruch!\", sagt der König ungeduldig,"
  },
  {
   "start": 6.189,
   "end": 9.589,
   "text": "\"Das ist nun aber wirklich alles, was ich für Dich tun konnte...:"
  },
  {
   "start": 9.657,
   "end": 12.549,
   "text": "Das Schicksal meiner Welt liegt in Deinen Händen,"
  },
  {
   "start": 12.581,
   "end": 15.749,
   "text": "doch meine Gebete begleiten Dich - leb' wohl...\""
  },
  {
   "start": 17.014,
   "end": 22.869,
   "text": "Der Geist des Königs wird immer transparenter, bis er schließlich ganz unsichtbar ist..."
  },
  {
   "start": 23.085,
   "end": 27.909,
   "text": "Angesichts der schweren Bürde, die durch diese ungeheure Verantwortung auf Dir lastet,"
  },
  {
   "start": 27.949,
   "end": 31.829,
   "text": "fühlst Du Dich auf einmal unwahrscheinlich allein und verlassen..."
  }
 ]
}
