 ],
 "cues": [
  {
   "start": 2.695,
   "end": 4.9,
   "text": "Verzweifelt kniest Du vor dem Altar nieder"
  },
  {
   "start": 5.04,
   "end": 8.499,
   "text": "und schickst ein Stoßgebet nach geistvolleren Texten,"
  },
  {
   "start": 8.5,
   "end": 11.62,
   "text": "besseren Grafiken, leistungsfähigeren Computern"
  },
  {
   "start": 11.66,
   "end": 14.34,
   "text": "und kompetenteren Programmierern zum Himmel,"
  },
  {
   "start": 14.64,
   "end": 19.3,
   "text": "und nebenbei denkst Du auch an den armen, armen Klosterbruder Jack,"
  },
  {
   "start": 19.34,
   "end": 23.06,
   "text": "der hier wohl irgendwann mal vom Schlitten gerutscht sein soll -"
  },
  {
   "start": 23.127,
   "end": 28.9,
   "text": "doch nach wenigen Versen bekommst Du das ungute Gefühl, als wäre etwas hinter Dir -"
  },
  {
   "start": 28.94,
   "end": 32.66,
   "text": "und drehst Dich um: Du fühlst eine leichte,"
  },
  {
   "start": 32.708,
   "end": 36.26,
   "text": "aber eisig kalte Brise durch den Raum streichen,"
  },
  {
   "start": 36.32,
   "end": 39.22,
   "text": "als Du den Nebel im Kirchenschiff bemerkst,"
  },
  {
   "start": 39.24,
   "end": 44.26,
   "text": "der langsam auf Dich zukommt und dabei dichter und dichter wird,"
  },
  {
   "start": 44.3,
   "end": 46.82,
   "text": "bis er schließlich kurz vor Dir stehenbleibt..."
  },
  {
   "start": 47.407,
   "end": 52.9,
   "text": "Du spürst, wie sich in Deinem Nacken die ersten kalten Schweißperlen bilden,"
  },
  {
   "start": 52.94,
   "end": 56.541,
   "text": "und zitternd vor Angst stammelst Du: \"Au Scheiße!"
  },
  {
   "start": 56.634,
   "end": 60.741,
   "text": "Alles klar, Leute: Vergeßt das mit den geistvollen Texten und so..."
  },
  {
   "start": 60.781,
   "end": 61.781,
   "text": "War nur'n blöder Witz!"
  },
  {
   "start": 61.914,
   "end": 63.221,
   "text": "Alles in Ordnung, echt!\""
  },
  {
   "start": 64.629,
   "end": 68.821,
   "text": "Doch gerade, bevor Du Dir vor Angst in Deine einzige Hose machen kannst,"
  },
  {
   "start": 68.921,
   "end": 74.261,
   "text": "nimmt der Nebel, den Du eigentlich für eine dieser mysteriösen Wolken gehalten hast,"
  },
  {
   "start": 74.288,
   "end": 78.261,
   "text": "durch die hier wohl jeder in himmlische Gefilde abkommandiert wird,"
  },
  {
   "start": 78.325,
   "end": 83.861,
   "text": "menschliche Umrisse an - und vor Dir steht: BRUDER JACK!"
  },
  {
   "start": 84.968,
   "end": 88.661,
   "text": "Er begrüßt Dich mit den Worten: \"Friede sei mit Dir, mein Sohn!\","
  },
  {
   "start": 89.431,
   "end": 95.301,
   "text": "schaut dann auf Deine Beinkleider, grinst und fragt scheinheilig: \"Deine Hosen..."
  },
  {
   "start": 95.341,
   "end": 97.141,
   "text": "Ähem: Alles in Ordnung?\""
  }
 ]
}
