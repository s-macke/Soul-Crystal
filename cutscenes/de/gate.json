 "cues": [
  {
   "start": 2.535,
   "end": 4.708,
   "text": "Du glaubst Deinen Augen nicht trauen zu können:"
  },
  {
   "start": 4.868,
   "end": 9.228,
   "text": "Das Portaltor steht tatsächlich sperrangelweit offen!"
  },
  {
   "start": 9.714,
   "end": 13.834,
   "text": "Unter dem Torbogen kannst Du den Geist König Richards schweben sehen,"
  },
  {
   "start": 13.874,
   "end": 17.434,
   "text": "der Dir gütig und dankbar zuzulächeln scheint -"
  },
  {
   "start": 17.474,
   "end": 20.394,
   "text": "und auch die Vögel zwitschern wieder von den Bäumen herab:"
  },
  {
   "start": 20.574,
   "end": 25.834,
   "text": "Das ganze Land blüht wieder auf, zum ersten Mal seit langer, langer Zeit!"
  },
  {
   "start": 27.087,
   "end": 29.674,
   "text": "Feierlich gehst Du auf Deinen neugewonnenen Freund"
  },
  {
   "start": 29.807,
   "end": 35.114,
   "text": "zu und läßt die finsteren Burgmauern für immer hinter Dir..."
  },
  {
   "start": 35.389,
   "end": 35.913,
   "text": "FREI..."
  }
 ]
}
