 "cues": [
  {
   "start": 2.572,
   "end": 4.11,
   "text": "Es überrascht Firon ein wenig,"
  },
  {
   "start": 4.15,
   "end": 8.99,
   "text": "daß Du nicht gleich kurzen Prozeß mit ihm machst, wie eigentlich mit Mylgor abgesprochen."
  },
  {
   "start": 9.087,
   "end": 12.27,
   "text": "Nach einer kurzen Pause nickt er jedoch bedächtig:"
  },
  {
   "start": 12.855,
   "end": 15.555,
   "text": "\"So erfüllt sich denn endlich die Prophezeiung...\","
  },
  {
   "start": 15.619,
   "end": 21.075,
   "text": "sagt er, \"Wenn Du mich nun wirklich verschonen willst, werde ich Dir im Gegenzug verraten,"
  },
  {
   "start": 21.115,
   "end": 25.956,
   "text": "wie Du die volle Wahrheit darüber herausfinden kannst, was in diesem Land passiert ist,"
  },
  {
   "start": 25.995,
   "end": 28.596,
   "text": "und wer für all die Dinge verantwortlich ist,"
  },
  {
   "start": 28.615,
   "end": 30.995,
   "text": "die Du teilweise vielleicht sogar schon gesehen hast...\""
  }
 ]
