 "cues": [
  {
   "start": 2.636,
   "end": 6.66,
   "text": "Der alte Elfenkönig erhebt sich von seinem Thron: \"Ich wußte,"
  },
  {
   "start": 6.7,
   "end": 10.58,
   "text": "daß Du eines Tages kommen und den Befehl Deines Herren erfüllen würdest."
  },
  {
   "start": 10.66,
   "end": 13.62,
   "text": "Nun tu Deine Pflicht und vernichte auch noch den letzten"
  },
  {
   "start": 13.7,
   "end": 17.7,
   "text": "Sproß eines edlen Geschlechts - ich werde mich nicht wehren!"
  },
  {
   "start": 17.887,
   "end": 20.66,
   "text": "So lange habe ich auf diesen Augenblick gewartet,"
  },
  {
   "start": 20.68,
   "end": 23.78,
   "text": "und es wird Zeit, daß wir es hinter uns bringen...\","
  },
  {
   "start": 23.91,
   "end": 25.78,
   "text": "antwortet er Dir mit sanfter Stimme,"
  },
  {
   "start": 25.807,
   "end": 31.3,
   "text": "in deren Melodie so etwas wie Melancholie und Resignation mitschwingt..."
  }
 ]
}
