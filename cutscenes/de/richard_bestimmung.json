 "cues": [
  {
   "start": 3.03,
   "end": 4.45,
   "text": "Der König nickt zustimmend."
  },
  {
   "start": 4.77,
   "end": 8.13,
   "text": "\"Du hast recht: Wir haben keine Zeit mehr zu verlieren!\","
  },
  {
   "start": 8.17,
   "end": 11.65,
   "text": "beschließt er, \"Die Zeit ist reif, zurückzuschlagen,"
  },
  {
   "start": 11.73,
   "end": 14.77,
   "text": "Zargon seiner gerechten Strafe zuzuführen und die"
  },
  {
   "start": 14.83,
   "end": 18.33,
   "text": "Bewohner meines Reiches aus seiner Tyrannis zu befreien!"
  },
  {
   "start": 18.99,
   "end": 20.53,
   "text": "Wie Du sehen kannst...\""
  },
  {
   "start": 20.55,
   "end": 22.21,
   "text": "- er schaut traurig an sich herunter -"
  },
  {
   "start": 22.37,
   "end": 26.77,
   "text": "\"...erlaubt es mir meine übernatürliche Erscheinungsform leider nicht mehr,"
  },
  {
   "start": 26.85,
   "end": 30.37,
   "text": "Zargon persönlich herauszufordern und das Unheil,"
  },
  {
   "start": 30.41,
   "end": 33.17,
   "text": "das er über uns alle gebracht hat, zu sühnen,"
  },
  {
   "start": 33.218,
   "end": 37.57,
   "text": "aber vielleicht bist Du ja stark und klug genug, um es zumindest zu versuchen!"
  },
  {
   "start": 38.721,
   "end": 39.014,
   "text": "Nein!"
  },
  {
   "start": 39.134,
   "end": 40.294,
   "text": "Sag' jetzt nichts!"
  },
  {
   "start": 40.454,
   "end": 42.574,
   "text": "Du darfst mir nicht widersprechen:"
  },
  {
   "start": 42.678,
   "end": 47.494,
   "text": "Dies hier ist nicht bloß irgendeine Aufgabe - es ist Deine Bestimmung!\""
  },
  {
   "start": 48.124,
   "end": 51.147,
   "text": "König Richard schaut Dich aus flehenden Augen an..."
  }
 ]
}
