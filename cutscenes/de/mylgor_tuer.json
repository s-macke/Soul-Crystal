 "cues": [
  {
   "start": 2.569,
   "end": 7.62,
   "text": "Du klopfst zaghaft an die Tür und wartest: Nichts passiert!"
  },
  {
   "start": 7.993,
   "end": 13.54,
   "text": "Du klopfst noch einmal, diesmal etwas lauter: Keine Reaktion!"
  },
  {
   "start": 14.222,
   "end": 19.142,
   "text": "Gerade willst Du mit aller Kraft gegen die Tür hämmern, als sich, just an der Stelle,"
  },
  {
   "start": 19.162,
   "end": 21.462,
   "text": "auf der sich um ein Haar die zerstörerische"
  },
  {
   "start": 21.502,
   "end": 24.822,
   "text": "Wirkung Deiner kraftvollen Fäuste in ihrer ganzen,"
  },
  {
   "start": 24.842,
   "end": 30.422,
   "text": "schrecklichen Größe offenbart hätte, eine kleine Luke öffnet, hinter der ein Gesicht,"
  },
  {
   "start": 30.442,
   "end": 34.822,
   "text": "das sich im Halbdunkel jedoch nur sehr schwer identifizieren läßt, erscheint!"
  },
  {
   "start": 36.242,
   "end": 40.501,
   "text": "\"Was ist Dein Begehr, Fremder?\", fragt die Stimme hinter der Tür mißtrauisch."
  }
 ]
}
