 "cues": [
  {
   "start": 2.804,
   "end": 2.98,
   "text": "Himmel!"
  },
  {
   "start": 3.247,
   "end": 6.66,
   "text": "Es ist wohl schon zu spät, um noch an Flucht zu denken:"
  },
  {
   "start": 6.753,
   "end": 9.46,
   "text": "Starr vor Entsetzen mußt Du zusehen,"
  },
  {
   "start": 9.48,
   "end": 12.98,
   "text": "wie sich hinter einem verwitterten Grabstein ein riesiger,"
  },
  {
   "start": 13.026,
   "end": 16.98,
   "text": "schwarzer Schatten erhebt - nur einige Meter neben Dir!"
  },
  {
   "start": 17.3,
   "end": 23.78,
   "text": "Zu keiner Bewegung fähig, mußt Du mit ansehen, wie er lautlos größer und größer wird..."
  },
  {
   "start": 24.907,
   "end": 29.68,
   "text": "Plötzlich reißt die Wolkendecke, die den Vollmond für kurze Zeit verdeckt hatte,"
  },
  {
   "start": 29.72,
   "end": 33.2,
   "text": "auseinander - und Du schreist in panischer Todesangst auf:"
  },
  {
   "start": 33.413,
   "end": 37.44,
   "text": "Dein Gegner ist ein riesiger, grauer Werwolf,"
  },
  {
   "start": 37.48,
   "end": 40.72,
   "text": "der siegesgewiß seine scharfen, gelben Zähne bleckt!"
  },
  {
   "start": 41.013,
   "end": 46.08,
   "text": "Heiser fauchend und mit ausgestreckten Armen setzt er sich in Bewegung -"
  },
  {
   "start": 46.12,
   "end": 49.92,
   "text": "Schritt für Schritt, denn er kennt keine Eile..."
  },
  {
   "start": 50.054,
   "end": 51.44,
   "text": "Doch plötzlich bleibt er stehen!"
  },
  {
   "start": 51.62,
   "end": 56.0,
   "text": "Für Bruchteile von Sekunden treffen sich Eure Blicke und Du spürst"
  },
  {
   "start": 56.04,
   "end": 61.6,
   "text": "die Mordlust und den abgrundtiefen Haß, die in seinen Augen lodern..."
  }
 ]
}
