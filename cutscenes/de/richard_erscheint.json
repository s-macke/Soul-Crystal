 "cues": [
  {
   "start": 2.65,
   "end": 8.46,
   "text": "Vorsichtig legst Du den Schädel neben den Rumpf des Königs - aber was ist denn das?"
  },
  {
   "start": 8.963,
   "end": 13.303,
   "text": "Der Totenschädel rollt zum Hals des Skelettes und wächst dort wieder an,"
  },
  {
   "start": 13.343,
   "end": 16.343,
   "text": "als ob er niemals irgendwo anders gewesen wäre!"
  },
  {
   "start": 17.13,
   "end": 18.663,
   "text": "Im selben Moment jedoch,"
  },
  {
   "start": 18.723,
   "end": 22.823,
   "text": "als der Schädel des Königs an seinen angestammten Platz zurückkehrt,"
  },
  {
   "start": 22.863,
   "end": 26.183,
   "text": "fühlst Du einen eiskalten Wind im Nacken..."
  },
  {
   "start": 26.223,
   "end": 28.263,
   "text": "Mal wieder das Schlimmste befürchtend,"
  },
  {
   "start": 28.303,
   "end": 31.943,
   "text": "schließt Du angsterfüllt die Augen: Nichts passiert..."
  },
  {
   "start": 32.283,
   "end": 37.183,
   "text": "Als Du sie jedoch wieder zu öffnen wagst - ist der Sarg leer!"
  },
  {
   "start": 37.356,
   "end": 40.903,
   "text": "Du schließt Deine Augen zum zweiten Mal und öffnest sie wieder:"
  },
  {
   "start": 41.063,
   "end": 46.743,
   "text": "Aber nichts hat sich geändert: Der Sarkophag des Königs ist und bleibt leer!"
  },
  {
   "start": 47.996,
   "end": 52.023,
   "text": "Bevor Du jedoch versuchen kannst, auf Deinen schlotternden Beinen davonzulaufen,"
  },
  {
   "start": 52.063,
   "end": 54.823,
   "text": "hörst Du eine offensichtlich recht amüsierte,"
  },
  {
   "start": 54.883,
   "end": 60.183,
   "text": "sanfte Stimme hinter Dir: \"Willkommen, mein Freund...\""
  },
  {
   "start": 60.21,
   "end": 61.303,
   "text": "Es ist König Richard!"
  }
 ]
}
