 "cues": [
  {
   "start": 2.57,
   "end": 5.63,
   "text": "Als der Wolf Dich auf die Lichtung stürmen sieht,"
  },
  {
   "start": 5.67,
   "end": 8.83,
   "text": "erschrickt er derartig über Deine hagere Figur,"
  },
  {
   "start": 8.85,
   "end": 12.35,
   "text": "daß er sofort den Schwanz einzieht und die Beine in die Pfoten nimmt!"
  },
  {
   "start": 13.918,
   "end": 17.39,
   "text": "Nachdem er, noch immer erschüttert über soviel Elend,"
  },
  {
   "start": 17.47,
   "end": 20.35,
   "text": "jaulend im Unterholz verschwunden ist,"
  },
  {
   "start": 20.41,
   "end": 24.27,
   "text": "legt sich das angeschlagene Einhorn erschöpft auf den Boden,"
  },
  {
   "start": 24.297,
   "end": 28.03,
   "text": "um sich ein wenig von dem ungleichen Kampf zu erholen."
  },
  {
   "start": 28.243,
   "end": 33.75,
   "text": "Seine Nüstern beben nervös, und es atmet schwer und ungleichmäßig..."
  }
 ]
}
